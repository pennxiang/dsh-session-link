+/** Display-only relationships; neither registration nor rendering changes Session ownership. */
+import type { WorkspaceId } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** A created ordinary Session displayed below its creator in their shared Workspace. */
+export interface SessionRelationEdge {
+  readonly workspaceId: WorkspaceId
+  readonly sourceId: SessionId
+  readonly targetId: SessionId
+  readonly kind: 'created-session'
+}
+
+/** Stable provider snapshot; incomplete data never claims a complete relationship inventory. */
+export interface SessionRelationsSnapshot {
+  readonly schemaVersion: 1
+  readonly edges: readonly SessionRelationEdge[]
+  readonly truncated: boolean
+  readonly loading: boolean
+}
+
+/** One effect-owned provider; source and snapshot identities stay stable between changes. */
+export interface SessionRelationsRegistration {
+  readonly id: string
+  readonly version: 1
+  readonly source: HostObservable<SessionRelationsSnapshot>
+}
diff --git a/packages/client/ui-workspace/src/client/session-relations.ts b/packages/client/ui-workspace/src/client/session-relations.ts
new file mode 100644
index 00000000..e33ee111
--- /dev/null
+++ b/packages/client/ui-workspace/src/client/session-relations.ts
@@ -0,0 +1,211 @@
+/** Service-owned provider aggregation and pure display hierarchy derivation. */
+import type { SessionListState } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { WorkspaceId, WorkspaceView } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { SessionRelationEdge, SessionRelationsRegistration, SessionRelationsSnapshot } from './contract/session-relations.ts'
+import type { SessionNode } from './tree.ts'
+
+/** Observable aggregate owned and disposed by one UiWorkspace service. */
+export class SessionRelationsRegistry {
+  private readonly providers = new Map<string, { source: SessionRelationsRegistration['source']; dispose: () => void }>()
+  private readonly listeners = new Set<() => void>()
+  private snapshot: SessionRelationsSnapshot = { schemaVersion: 1, edges: [], loading: false, truncated: false }
+
+  /** @param onChange - owner notification; unlike a browser subscription, it does not activate providers. */
+  constructor(private readonly onChange: () => void = () => {}) {}
+
+  /** @returns the same immutable snapshot until a provider publishes or registration changes. */
+  getSnapshot = (): SessionRelationsSnapshot => this.snapshot
+
+  /** @param listener - aggregate change observer. @returns observer cleanup. */
+  subscribe = (listener: () => void): (() => void) => {
+    const first = this.listeners.size === 0
+    this.listeners.add(listener)
+    if (first) {
+      for (const provider of this.providers.values()) provider.dispose = provider.source.subscribe(this.publish)
+      this.publish()
+    }
+    return () => {
+      this.listeners.delete(listener)
+      if (this.listeners.size !== 0) return
+      for (const provider of this.providers.values()) {
+        provider.dispose()
+        provider.dispose = () => {}
+      }
+      this.publish()
+    }
+  }
+
+  /** @param registration - uniquely named provider. @returns idempotent provider cleanup. */
+  register(registration: SessionRelationsRegistration): () => void {
+    if (this.providers.has(registration.id)) throw new Error(`Session relations provider already registered: ${registration.id}`)
+    const provider = { source: registration.source, dispose: () => {} }
+    this.providers.set(registration.id, provider)
+    try {
+      if (this.listeners.size > 0) provider.dispose = registration.source.subscribe(this.publish)
+      this.publish()
+    } catch (error) {
+      this.providers.delete(registration.id)
+      provider.dispose()
+      throw error
+    }
+    return () => {
+      if (this.providers.get(registration.id) !== provider) return
+      this.providers.delete(registration.id)
+      provider.dispose()
+      this.publish()
+    }
+  }
+
+  /** Remove provider subscriptions and consumers when the owning service unloads. */
+  dispose(): void {
+    for (const provider of this.providers.values()) provider.dispose()
+    this.providers.clear()
+    this.publish()
+    this.listeners.clear()
+  }
+
+  private publish = (): void => {
+    const snapshots = [...this.providers.values()].map(provider => provider.source.getSnapshot())
+    this.snapshot = {
+      schemaVersion: 1,
+      edges: snapshots.flatMap(snapshot => snapshot.edges),
+      loading: snapshots.some(snapshot => snapshot.loading),
+      truncated: snapshots.some(snapshot => snapshot.truncated),
+    }
+    this.onChange()
+    for (const listener of this.listeners) listener()
+  }
+}
+
+/**
+ * Resolve display parents against authoritative ordinary Session membership.
+ * Earlier edges win conflicts; cyclic candidates and ambiguous Workspace membership are omitted.
+ * @param summaries - current Session catalog.
+ * @param workspaces - registered Workspace membership, independent of display order.
+ * @param edges - registered display-only relationships in provider order.
+ * @returns a single-parent acyclic map; no Session objects are modified.
+ */
+export function sessionRelationParents(
+  summaries: SessionListState['byId'],
+  workspaces: readonly WorkspaceView[],
+  edges: readonly SessionRelationEdge[],
+): ReadonlyMap<SessionId, SessionId> {
+  const owners = new Map<SessionId, WorkspaceId | null>()
+  for (const workspace of workspaces) {
+    for (const id of workspace.sessionIds) {
+      const existing = owners.get(id)
+      owners.set(id, existing === undefined || existing === workspace.workspaceId ? workspace.workspaceId : null)
+    }
+  }
+  const parents = new Map<SessionId, SessionId>()
+  for (const edge of edges) {
+    if (edge.sourceId === edge.targetId || parents.has(edge.targetId)) continue
+    if (owners.get(edge.sourceId) !== edge.workspaceId || owners.get(edge.targetId) !== edge.workspaceId) continue
+    const source = summaries[edge.sourceId]
+    const target = summaries[edge.targetId]
+    if (source === undefined || target === undefined || source.origin === 'subagent' || target.origin === 'subagent') continue
+    if (source.parentId !== undefined || target.parentId !== undefined) continue
+    let ancestor: SessionId | undefined = edge.sourceId
+    while (ancestor !== undefined && ancestor !== edge.targetId) ancestor = parents.get(ancestor)
+    if (ancestor === edge.targetId) continue
+    parents.set(edge.targetId, edge.sourceId)
+  }
+  return parents
+}
+
+/** @param workspaceId - owning Workspace. @param sessionId - parent row. @returns unambiguous persisted expansion key. */
+export function sessionRelationExpansionKey(workspaceId: WorkspaceId, sessionId: SessionId): string {
+  return JSON.stringify([workspaceId, sessionId])
+}
+
+/** One branch step; only the final sibling ends its connector at the row midpoint. */
+export interface SessionRelationBranch {
+  readonly id: SessionId
+  readonly last: boolean
+}
+
+/** Native row plus display-only hierarchy information. */
+export interface RelatedSessionRow {
+  readonly node: SessionNode
+  readonly displayParentId?: SessionId
+  readonly branches: readonly SessionRelationBranch[]
+  readonly hasChildren: boolean
+  readonly expanded: boolean
+}
+
+/**
+ * Admit complete relation components intersecting a native watermark and flatten each below its root.
+ * Only root collapse applies; descendant preferences are ignored. DFS order and metadata edges stay intact.
+ * Hidden parents detach their visible children; unrelated rows retain native watermark and ordering.
+ * @param sessions - all native rows after visibility filters.
+ * @param seeds - rows selected by the native watermark.
+ * @param parents - authoritative display parents.
+ * @param workspaceId - absent for Ungrouped, which stays flat.
+ * @param expansion - browser-local relation expansion preferences.
+ * @returns projected rows and nonblank rows still outside the watermark (not collapsed descendants).
+ */
+export function relatedSessionRows(
+  sessions: readonly SessionNode[],
+  seeds: readonly SessionNode[],
+  parents: ReadonlyMap<SessionId, SessionId>,
+  workspaceId: WorkspaceId | undefined,
+  expansion: Readonly<Record<string, boolean>>,
+): { rows: readonly RelatedSessionRow[]; hiddenCount: number } {
+  const visible = new Set(sessions.filter(row => !row.archived).map(row => row.id))
+  const displayParents = new Map<SessionId, SessionId>()
+  if (workspaceId !== undefined) {
+    for (const node of sessions) {
+      const parent = parents.get(node.id)
+      if (!node.archived && parent !== undefined && visible.has(parent)) displayParents.set(node.id, parent)
+    }
+  }
+  const roots = new Map<SessionId, SessionId>()
+  for (const node of sessions) {
+    const path: SessionId[] = []
+    let root = node.id
+    while (!roots.has(root) && displayParents.has(root)) {
+      path.push(root)
+      root = displayParents.get(root)!
+    }
+    root = roots.get(root) ?? root
+    roots.set(node.id, root)
+    for (const id of path) roots.set(id, root)
+  }
+  const admitted = new Set(seeds.map(row => roots.get(row.id)!))
+  const children = new Map<SessionId, SessionNode[]>()
+  const top: SessionNode[] = []
+  let hiddenCount = 0
+  for (const node of sessions) {
+    if (!admitted.has(roots.get(node.id)!)) {
+      if (!node.blank) hiddenCount++
+      continue
+    }
+    const parent = displayParents.get(node.id)
+    if (parent === undefined) top.push(node)
+    else {
+      const siblings = children.get(parent) ?? []
+      siblings.push(node)
+      children.set(parent, siblings)
+    }
+  }
+  const rows: RelatedSessionRow[] = []
+  for (const root of top) {
+    const directChildren = children.get(root.id) ?? []
+    const expanded = workspaceId === undefined || expansion[sessionRelationExpansionKey(workspaceId, root.id)] !== false
+    rows.push({ node: root, branches: [], hasChildren: directChildren.length > 0, expanded })
+    if (!expanded) continue
+    const descendants: SessionNode[] = []
+    const pending = [...directChildren].reverse()
+    while (pending.length > 0) {
+      const child = pending.pop()!
+      descendants.push(child)
+      const next = children.get(child.id) ?? []
+      for (let i = next.length - 1; i >= 0; i--) pending.push(next[i]!)
+    }
+    for (const [index, node] of descendants.entries()) {
+      rows.push({ node, displayParentId: root.id, branches: [{ id: node.id, last: index === descendants.length - 1 }], hasChildren: false, expanded: true })
+    }
+  }
+  return { rows, hiddenCount }
+}
