+/** Display and control contract for server-planned archive groups; independent of relation metadata. */
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** The user's archive range; consent to stopping activity is separate. */
+export type SessionArchiveScope = 'single' | 'related'
+
+/** A scope question, not a plan: it names no frozen members and cannot be committed. */
+export interface SessionArchiveScopeChoice {
+  readonly kind: 'scope-choice'
+  readonly targetId: SessionId
+  readonly allowedScopes: readonly SessionArchiveScope[]
+}
+
+/** Sanitized activity facts; nullable identifiers are not native Session identities. */
+export interface SessionArchiveActivity {
+  readonly kind: string
+  readonly items: readonly { readonly id: string | null; readonly label: string | null }[]
+  readonly totalItems: number
+}
+
+/** An immutable server plan. The provider, never the visible sidebar, determines its scope. */
+export interface SessionArchivePlan {
+  readonly planId: string
+  readonly archiveScope: SessionArchiveScope
+  readonly targetId: SessionId
+  readonly targets: readonly { readonly id: SessionId; readonly alreadyArchived: boolean; readonly title?: string }[]
+  readonly activity: readonly {
+    readonly sessionId: SessionId
+    readonly title?: string
+    readonly groups: readonly SessionArchiveActivity[]
+    readonly totalGroups: number
+  }[]
+  readonly requiresConfirmation: boolean
+  readonly total: number
+}
+
+/** A non-atomic commit result. Archived identities remain useful even when the commit is incomplete. */
+export interface SessionArchiveCommitOutcome {
+  readonly archiveScope: SessionArchiveScope
+  readonly archiveState: 'succeeded' | 'partial' | 'unknown' | 'failed'
+  readonly archivedIds: readonly SessionId[]
+  readonly remaining: readonly SessionId[]
+  readonly failed: readonly { readonly id: SessionId; readonly state: 'failed' | 'unknown' }[]
+  readonly stopActivityRequested: boolean
+}
+
+/** Register through the owning plugin's ctx.effect; dispose invalidates every uncommitted plan. */
+export interface SessionArchiveProvider {
+  readonly id: string
+  readonly version: 2
+  prepare(sessionId: SessionId, options?: { readonly archiveScope?: SessionArchiveScope }): Promise<SessionArchiveScopeChoice | SessionArchivePlan | undefined>
+  commit(plan: SessionArchivePlan, options: { readonly archiveScope: SessionArchiveScope; readonly stopActivity: boolean }): Promise<SessionArchiveCommitOutcome>
+}
+
+/** Shared UI result; successful single scope keeps singleton undo, related scope never does. */
+export type SessionArchiveOutcome =
+  | { readonly kind: 'single' }
+  | { readonly kind: 'scope-choice'; readonly choice: SessionArchiveScopeChoice }
+  | { readonly kind: 'confirmation'; readonly plan: SessionArchivePlan }
+  | { readonly kind: 'group'; readonly plan: SessionArchivePlan; readonly result: SessionArchiveCommitOutcome }
