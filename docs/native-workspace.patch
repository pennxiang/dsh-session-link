+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { SessionArchivePlan, SessionArchiveCommitOutcome, SessionArchiveScopeChoice } from '../src/client/contract/session-archive.ts'
+
+export function archiveChoice(): SessionArchiveScopeChoice {
+  return { kind: 'scope-choice', targetId: SessionId('one'), allowedScopes: ['single', 'related'] }
+}
+
+export function singleArchivePlan(requiresConfirmation = false): SessionArchivePlan {
+  return { archiveScope: 'single', planId: 'single-plan', targetId: SessionId('one'), total: 1,
+    targets: [{ id: SessionId('one'), title: 'Parent title', alreadyArchived: false }], requiresConfirmation,
+    activity: requiresConfirmation ? [{ sessionId: SessionId('one'), totalGroups: 1, groups: [{ kind: 'turn', items: [], totalItems: 1 }] }] : [] }
+}
+
+export function singleArchiveResult(): SessionArchiveCommitOutcome {
+  return { archiveScope: 'single', archiveState: 'succeeded', archivedIds: [SessionId('one')], remaining: [], failed: [], stopActivityRequested: false }
+}
+
+export function archivePlan(requiresConfirmation = true): SessionArchivePlan {
+  return {
+    archiveScope: 'related', planId: 'server-plan', targetId: SessionId('one'), total: 2, requiresConfirmation,
+    targets: [
+      { id: SessionId('child'), title: 'Child title', alreadyArchived: false },
+      { id: SessionId('one'), title: 'Parent title', alreadyArchived: false },
+    ],
+    activity: requiresConfirmation ? [{ sessionId: SessionId('child'), title: 'Child title', totalGroups: 2,
+      groups: [{ kind: 'job', items: [{ id: null, label: null }, { id: 'job-2', label: 'Build' }], totalItems: 3 }] }] : [],
+  }
+}
+
+export function archiveResult(archiveState: SessionArchiveCommitOutcome['archiveState'] = 'succeeded'): SessionArchiveCommitOutcome {
+  return {
+    archiveScope: 'related', archiveState,
+    archivedIds: archiveState === 'succeeded' ? [SessionId('child'), SessionId('one')] : [SessionId('child')],
+    remaining: archiveState === 'succeeded' ? [] : [SessionId('one')],
+    failed: archiveState === 'succeeded' ? [] : [{ id: SessionId('one'), state: 'unknown' }],
+    stopActivityRequested: true,
+  }
+}
