+  it('does not fall back after provider failure or retry an uncertain commit', async () => {
+    const b = bench()
+    const plan = archivePlan(false)
+    const commit = vi.fn(async () => { throw new Error('ARCHIVE_PLAN_CHANGED') })
+    b.uiWorkspace.registerSessionArchiveProvider({ id: 'provider', version: 2, prepare: async () => plan, commit })
+    await expect(b.uiWorkspace.archiveSessionWithOutcome(sid('one'))).resolves.toEqual({ kind: 'confirmation', plan })
+    await expect(b.uiWorkspace.archiveSessionWithOutcome(sid('one'), { plan })).rejects.toThrow('ARCHIVE_PLAN_CHANGED')
+    await expect(b.uiWorkspace.archiveSessionWithOutcome(sid('one'), { plan, stopActivity: true })).rejects.toThrow()
+    expect(commit).toHaveBeenCalledOnce()
+    expect(b.workspaces.archiveCalls).toEqual([])
+  })
+})
+
+describe('display relation navigation', () => {
+  it.each([false, true])('handles late edges once, respecting newer navigation (%s) and later manual collapse', (navigateAway) => {
+    const b = bench({ sessions: sessionState(['a', 'b', 'c', 'plain'].map(id => summary(id))), workspaces: workspaceState([workspace('w', ['a', 'b', 'c', 'plain'].map(sid))]) })
+    const source = new MutableSource<SessionRelationsSnapshot>({ schemaVersion: 1, edges: [], loading: true, truncated: false })
+    b.uiWorkspace.registerSessionRelations({ id: 'late', version: 1, source })
+    b.uiWorkspace.sessionRelations.subscribe(() => {})
+    b.view.actions.setSessionRelationExpanded(wid('w'), sid('a'), false)
+    b.view.actions.setSessionRelationExpanded(wid('w'), sid('b'), false)
+    b.uiWorkspace.openSession(sid('c'))
+    if (navigateAway) b.uiWorkspace.openSession(sid('plain'))
+    expect(b.view.getSnapshot().sessionRelationExpansion?.[sessionRelationExpansionKey(wid('w'), sid('a'))]).toBe(false)
+    const ready: SessionRelationsSnapshot = { schemaVersion: 1, loading: false, truncated: false, edges: [
+      { workspaceId: wid('w'), sourceId: sid('a'), targetId: sid('b'), kind: 'created-session' },
+      { workspaceId: wid('w'), sourceId: sid('b'), targetId: sid('c'), kind: 'created-session' },
+    ] }
+    source.set(ready)
+    expect(b.view.getSnapshot().sessionRelationExpansion?.[sessionRelationExpansionKey(wid('w'), sid('a'))]).toBe(!navigateAway)
+    expect(b.view.getSnapshot().sessionRelationExpansion?.[sessionRelationExpansionKey(wid('w'), sid('b'))]).toBe(false)
+    b.view.actions.setSessionRelationExpanded(wid('w'), sid('a'), false)
+    source.set({ ...ready })
+    expect(b.view.getSnapshot().sessionRelationExpansion?.[sessionRelationExpansionKey(wid('w'), sid('a'))]).toBe(false)
+  })
+
+  it.each(['archived', 'blank'] as const)('reveals the orphan root below a %s ancestor', (hidden) => {
+    const b = bench({
+      sessions: sessionState([summary('a', { blank: hidden === 'blank' }), summary('b'), summary('c')]),
+      workspaces: workspaceState([workspace('w', ['a', 'b', 'c'].map(sid))], hidden === 'archived' ? [sid('a')] : []),
+    })
+    const source = new MutableSource<SessionRelationsSnapshot>({ schemaVersion: 1, loading: false, truncated: false, edges: [
+      { workspaceId: wid('w'), sourceId: sid('a'), targetId: sid('b'), kind: 'created-session' },
+      { workspaceId: wid('w'), sourceId: sid('b'), targetId: sid('c'), kind: 'created-session' },
+    ] })
+    b.uiWorkspace.registerSessionRelations({ id: 'orphan', version: 1, source })
+    b.view.actions.setSessionRelationExpanded(wid('w'), sid('a'), false)
+    b.view.actions.setSessionRelationExpanded(wid('w'), sid('b'), false)
+    b.uiWorkspace.openSession(sid('c'))
+    expect(b.view.getSnapshot().sessionRelationExpansion).toEqual({
+      [sessionRelationExpansionKey(wid('w'), sid('a'))]: false,
+      [sessionRelationExpansionKey(wid('w'), sid('b'))]: true,
+    })
+  })
+
+  it('reveals only the visible root through native navigation, retaining old child preferences and provider cleanup', async () => {
+    const b = bench({
+      sessions: sessionState(['a', 'b', 'c'].map(id => summary(id))),
+      workspaces: workspaceState([workspace('w', ['a', 'b', 'c'].map(sid))]),
+    })
+    const source = new MutableSource<SessionRelationsSnapshot>({ schemaVersion: 1, loading: false, truncated: false, edges: [
+      { workspaceId: wid('w'), sourceId: sid('a'), targetId: sid('b'), kind: 'created-session' },
+      { workspaceId: wid('w'), sourceId: sid('b'), targetId: sid('c'), kind: 'created-session' },
+    ] })
+    expect(b.uiWorkspace.sessionRelationsVersion).toBe(1)
+    b.uiWorkspace.registerSessionRelations({ id: 'test', version: 1, source })
+    b.uiWorkspace.sessionRelations.subscribe(() => {})
+    b.view.actions.setSessionRelationExpanded(wid('w'), sid('a'), false)
+    b.view.actions.setSessionRelationExpanded(wid('w'), sid('b'), false)
+    b.view.actions.setSessionRelationExpanded(wid('other'), sid('a'), false)
+    b.uiWorkspace.openSession(sid('c'))
+    expect(b.view.getSnapshot().sessionRelationExpansion).toEqual({
+      [sessionRelationExpansionKey(wid('w'), sid('a'))]: true,
+      [sessionRelationExpansionKey(wid('w'), sid('b'))]: false,
+      [sessionRelationExpansionKey(wid('other'), sid('a'))]: false,
+    })
+    expect(b.sessions.retain).toHaveBeenCalledWith(sid('c'), expect.anything())
+    expect(source.listenersSnapshot()).toHaveLength(1)
+    await b.ctx.fiber.dispose()
+    expect(source.listenersSnapshot()).toHaveLength(0)
+  })
+})
