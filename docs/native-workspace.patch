@@ -0,0 +1,131 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { SessionListState, SessionSummary } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { WorkspaceId, WorkspaceView } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { SessionRelationEdge, SessionRelationsSnapshot } from '../src/client/contract/session-relations.ts'
+import { relatedSessionRows, sessionRelationExpansionKey, sessionRelationParents, SessionRelationsRegistry } from '../src/client/session-relations.ts'
+import type { SessionNode } from '../src/client/tree.ts'
+
+const sid = (id: string) => id as SessionId
+const wid = (id: string) => id as WorkspaceId
+const edge = (source: string, target: string, workspaceId = 'w'): SessionRelationEdge => ({ workspaceId: wid(workspaceId), sourceId: sid(source), targetId: sid(target), kind: 'created-session' })
+const workspace = (id: string, ids: string[]): WorkspaceView => ({ workspaceId: wid(id), sessionIds: ids.map(sid), path: `/${id}`, title: id, createdAt: '2026-01-01', updatedAt: '2026-01-01' })
+const catalog = (ids: string[], overrides: Record<string, Partial<SessionSummary>> = {}): SessionListState['byId'] => Object.fromEntries(ids.map(id => [id, { id: sid(id), title: id, displayTitle: id, running: false, blank: false, updatedAt: 0, retainedBy: {}, ...overrides[id] }]))
+const node = (id: string, overrides: Partial<SessionNode> = {}): SessionNode => ({ id: sid(id), title: id, blank: false, running: false, runningSubagentCount: 0, completed: false, pinned: false, archived: false, updatedAt: 0, ...overrides })
+const snapshot = (edges: SessionRelationEdge[] = []): SessionRelationsSnapshot => ({ schemaVersion: 1, edges, loading: false, truncated: false })
+
+class Source {
+  listeners = new Set<() => void>()
+  constructor(private value: SessionRelationsSnapshot = snapshot()) {}
+  getSnapshot = () => this.value
+  subscribe = (listener: () => void) => { this.listeners.add(listener); return () => { this.listeners.delete(listener) } }
+  set(value: SessionRelationsSnapshot) { this.value = value; for (const listener of this.listeners) listener() }
+}
+
+describe('SessionRelationsRegistry', () => {
+  it('only subscribes while the native browser observes, aggregates stable snapshots and releases each provider', () => {
+    const registry = new SessionRelationsRegistry()
+    const a = new Source(snapshot([edge('a', 'b')]))
+    const b = new Source({ ...snapshot(), loading: true, truncated: true })
+    const removeA = registry.register({ id: 'a', version: 1, source: a })
+    const removeB = registry.register({ id: 'b', version: 1, source: b })
+    expect(a.listeners.size).toBe(0)
+    expect(registry.getSnapshot()).toBe(registry.getSnapshot())
+    const listener = vi.fn()
+    const stop = registry.subscribe(listener)
+    expect(a.listeners.size).toBe(1)
+    expect(b.listeners.size).toBe(1)
+    expect(registry.getSnapshot()).toMatchObject({ edges: [edge('a', 'b')], loading: true, truncated: true })
+    a.set(snapshot([edge('a', 'c')]))
+    expect(registry.getSnapshot().edges).toEqual([edge('a', 'c')])
+    removeB(); removeB()
+    expect(b.listeners.size).toBe(0)
+    expect(registry.getSnapshot().loading).toBe(false)
+    stop()
+    expect(a.listeners.size).toBe(0)
+    const stopAgain = registry.subscribe(listener)
+    expect(a.listeners.size).toBe(1)
+    removeA(); stopAgain()
+    expect(registry.getSnapshot().edges).toEqual([])
+  })
+
+  it('rejects duplicate provider ids, rolls back failed admission, and disposes all subscriptions', () => {
+    const registry = new SessionRelationsRegistry()
+    const a = new Source()
+    registry.subscribe(() => {})
+    registry.register({ id: 'a', version: 1, source: a })
+    expect(() => registry.register({ id: 'a', version: 1, source: a })).toThrow('already registered')
+    expect(() => registry.register({ id: 'bad', version: 1, source: { getSnapshot: a.getSnapshot, subscribe: () => { throw new Error('subscription failed') } } })).toThrow('subscription failed')
+    registry.register({ id: 'bad', version: 1, source: new Source() })
+    registry.dispose()
+    expect(a.listeners.size).toBe(0)
+    expect(registry.getSnapshot().edges).toEqual([])
+  })
+})
