{
  "name": "dsh-session-link",
  "version": "0.1.0",
  "description": "Native Workspace relations, scoped messaging/tasks/activity and explicit-scope self/cross-session archive for DSH.",
  "repository": { "type": "git", "url": "https://github.com/pennxiang/dsh-session-link.git" },
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.1-rc.5 <0.3.0" },
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "files": ["index.js", "client.js", "lib", "cordis.patch.yml", "README.md", "SPEC.md", "NOTICE.md", "docs", "LICENSES"],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "test:host": "node scripts/host-smoke.mjs",
    "test:integration": "node scripts/isolated-host-smoke.mjs",
    "test:create-host": "node scripts/session-create-host-smoke.mjs",
    "test:client-host": "node scripts/client-module-host-smoke.mjs",
    "test:archive-host": "node scripts/archive-host-smoke.mjs",
    "build": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
